<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- flutter_go_torrent_streamer declares a notification foreground
         service that Reelish never starts (torrents stream only while the
         player is open). Drop it and the permissions it alone needs.
         POST_NOTIFICATIONS stays: new-episode alerts use it, and Android 13+
         asks the user only when they turn alerts on. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"
        tools:node="remove" />
    <!-- Android TV and Google TV. Neither feature is required, so phones and
         tablets install exactly as before, and TVs (no touchscreen) are not
         filtered out. ReelishActivity reports at runtime which kind of device
         it is running on; see lib/src/platform/device_capabilities.dart. -->
    <!-- Firebase Analytics asks for the advertising id; Reelish never uses
         one (see AnalyticsChannel.kt). -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <!-- Nor ad attribution (Privacy Sandbox) or Play install referrers,
         which the Firebase SDK also requests. -->
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />
    <uses-permission
        android:name="com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE"
        tools:node="remove" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <application
        android:label="reelish"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/tv_banner"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules">
        <service
            android:name="com.example.flutter_torrent_streamer.TorrentStreamerService"
            tools:node="remove" />
        <!-- Opt-in analytics: Firebase is not started at launch (it starts
             in AnalyticsChannel.kt after the viewer agrees), collection is
             off until then, and advertising ids, Android ids and ad
             personalization are never used. -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />
        <!-- Opt-in crash reports: off until the viewer agrees
             (CrashReportChannel.kt). -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_ssaid_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_personalization_signals"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_user_data"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_storage"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_analytics_storage"
            android:value="false" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>
        <!-- The only activity. Its launcher entries are the aliases below;
             the MAIN/LAUNCHER filter here is for `flutter run`/`drive`
             (flutter_tools finds the app through an <activity>, not an
             alias) and is removed from release builds by
             src/release/AndroidManifest.xml. -->
        <activity
            android:name=".ReelishActivity"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Launcher entries, one per app icon preset; exactly one is enabled
             (AppIconSwitcher.kt). The default keeps the component name of
             every earlier release, so home-screen and TV shortcuts survive
             updates. -->
        <activity-alias
            android:name=".MainActivity"
            android:targetActivity=".ReelishActivity"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Puts Reelish on the Android TV / Google TV home screen, shown
                 with the application banner. Phones ignore this category. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconAmber" android:targetActivity=".ReelishActivity"
            android:icon="@mipmap/ic_launcher_amber" android:roundIcon="@mipmap/ic_launcher_amber"
            android:exported="true" android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconBlue" android:targetActivity=".ReelishActivity"
            android:icon="@mipmap/ic_launcher_blue" android:roundIcon="@mipmap/ic_launcher_blue"
            android:exported="true" android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconGreen" android:targetActivity=".ReelishActivity"
            android:icon="@mipmap/ic_launcher_green" android:roundIcon="@mipmap/ic_launcher_green"
            android:exported="true" android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconIndigo" android:targetActivity=".ReelishActivity"
            android:icon="@mipmap/ic_launcher_indigo" android:roundIcon="@mipmap/ic_launcher_indigo"
            android:exported="true" android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconLime" android:targetActivity=".ReelishActivity"
            android:icon="@mipmap/ic_launcher_lime" android:roundIcon="@mipmap/ic_launcher_lime"
            android:exported="true" android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconOrange" android:targetActivity=".ReelishActivity"
            android:icon="@mipmap/ic_launcher_orange" android:roundIcon="@mipmap/ic_launcher_orange"
            android:exported="true" android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconRose" android:targetActivity=".ReelishActivity"
            android:icon="@mipmap/ic_launcher_rose" android:roundIcon="@mipmap/ic_launcher_rose"
            android:exported="true" android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconSlate" android:targetActivity=".ReelishActivity"
            android:icon="@mipmap/ic_launcher_slate" android:roundIcon="@mipmap/ic_launcher_slate"
            android:exported="true" android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconTeal" android:targetActivity=".ReelishActivity"
            android:icon="@mipmap/ic_launcher_teal" android:roundIcon="@mipmap/ic_launcher_teal"
            android:exported="true" android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconViolet" android:targetActivity=".ReelishActivity"
            android:icon="@mipmap/ic_launcher_violet" android:roundIcon="@mipmap/ic_launcher_violet"
            android:exported="true" android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <!-- The Signature icons, the supporter collection's own artwork
             (tool/branding/generate_signature_icons.mjs). -->
        <activity-alias android:name=".IconRoyalViolet" android:targetActivity=".ReelishActivity"
            android:icon="@mipmap/ic_launcher_royal_violet" android:roundIcon="@mipmap/ic_launcher_royal_violet"
            android:exported="true" android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconCelestial" android:targetActivity=".ReelishActivity"
            android:icon="@mipmap/ic_launcher_celestial" android:roundIcon="@mipmap/ic_launcher_celestial"
            android:exported="true" android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconAurora" android:targetActivity=".ReelishActivity"
            android:icon="@mipmap/ic_launcher_aurora" android:roundIcon="@mipmap/ic_launcher_aurora"
            android:exported="true" android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconRoseLuxe" android:targetActivity=".ReelishActivity"
            android:icon="@mipmap/ic_launcher_rose_luxe" android:roundIcon="@mipmap/ic_launcher_rose_luxe"
            android:exported="true" android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconGoldenHour" android:targetActivity=".ReelishActivity"
            android:icon="@mipmap/ic_launcher_golden_hour" android:roundIcon="@mipmap/ic_launcher_golden_hour"
            android:exported="true" android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconEmber" android:targetActivity=".ReelishActivity"
            android:icon="@mipmap/ic_launcher_ember" android:roundIcon="@mipmap/ic_launcher_ember"
            android:exported="true" android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconIvoryStudio" android:targetActivity=".ReelishActivity"
            android:icon="@mipmap/ic_launcher_ivory_studio" android:roundIcon="@mipmap/ic_launcher_ivory_studio"
            android:exported="true" android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
