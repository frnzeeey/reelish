<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup and device transfer. Only settings, history,
     favourites and installed plugin repositories (SharedPreferences) are
     included. Cached stream links (signed URLs and provider headers), torrent
     data and other caches are left out. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="FlutterSharedPreferences.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="FlutterSharedPreferences.xml" />
    </device-transfer>
</data-extraction-rules>
