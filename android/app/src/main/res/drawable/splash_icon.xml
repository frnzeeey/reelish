<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ splash icon. Without an icon background the system draws
     this in a 288dp box masked to a 192dp circle. A percentage inset scales
     with that box (a dp inset was measured on device to come out several
     times too small): 22.2% leaves the primary logo's canvas at 160dp,
     matching Flutter's first frame (SplashSpec), with its artwork (about
     100dp) well inside the circle. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/reelish_splash"
    android:inset="22.2%" />
