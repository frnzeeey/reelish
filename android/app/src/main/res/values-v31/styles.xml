<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash. Mirrors values-night-v31 so the splash is the
         same in light and dark mode: the night qualifier outranks v31, so
         without this file dark mode would skip these attributes. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- The Founder's system splash: the Sovereign Crest in place of the
         Reelish logo, same background and size. Applied with
         SplashScreen.setSplashScreenTheme (Android 13+) from ReelishActivity;
         the system stores it by name, so never rename it. One definition
         serves light and dark mode: LaunchTheme, its parent, has both. -->
    <style name="SovereignSplashTheme" parent="LaunchTheme">
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_sovereign_crest</item>
    </style>
</resources>
